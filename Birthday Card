<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maynard's Birthday Protocol</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandPrimary: '#7CB4CF',
                        brandSecondary: '#CBE1EC',
                        brandAccent: '#2C5E77',
                        brandDark: '#1E333F',
                        brandLightBg: '#ECF4F8'
                    },
                    fontFamily: {
                        sans: ['Calibri', 'Candara', 'Segoe UI', 'sans-serif'],
                        serif: ['Calibri', 'Candara', 'Segoe UI', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Force Calibri Across all system UI modules without overriding icon fonts */
        body, h1, h2, h3, h4, h5, h6, p, span, button, input, select, textarea, blockquote, q, a, label {
            font-family: 'Calibri', 'Candara', 'Segoe UI', sans-serif !important;
        }
        .slide-container {
            scroll-behavior: smooth;
        }
        .text-underline-accent {
            border-bottom: 3px solid #2C5E77;
        }
        /* Custom scrollbar to keep layout premium */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #CBE1EC;
        }
        ::-webkit-scrollbar-thumb {
            background: #7CB4CF;
            border-radius: 4px;
        }
        /* Shake Animation for Verification */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.3s ease-in-out;
        }
        /* Pulsing Glow for AI Elements */
        .ai-glow {
            box-shadow: 0 0 15px rgba(124, 180, 207, 0.6);
            border-color: #7CB4CF;
        }
        
        /* Symmetrical clinking animations where both champagne flutes tilt and move together */
        .glass-left-style {
            display: inline-block;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-origin: bottom right;
        }
        .glass-right-style {
            display: inline-block;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-origin: bottom left;
        }
        .clink-left {
            transform: translateX(20px) rotate(15deg);
        }
        .clink-right {
            transform: translateX(-20px) rotate(-15deg);
        }
        
        /* Floating animations for sparkling bubbles inside champagne flutes */
        @keyframes riseBubble {
            0% { transform: translateY(0) scale(0.8); opacity: 0; }
            50% { opacity: 0.8; }
            100% { transform: translateY(-40px) scale(1.2); opacity: 0; }
        }
        .champagne-bubble {
            animation: riseBubble 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-[#ECF4F8] text-[#1E333F] font-sans min-h-screen flex flex-col justify-between overflow-x-hidden selection:bg-brandPrimary selection:text-brandDark">

    <!-- TOP NAVIGATION & STATUS BAR -->
    <header class="w-full py-4 px-6 bg-white/80 backdrop-blur-md border-b border-brandPrimary/30 sticky top-0 z-40 flex justify-between items-center shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brandPrimary flex items-center justify-center shadow-lg shadow-brandPrimary/20">
                <i class="fa-solid fa-cake-candles text-brandDark text-lg"></i>
            </div>
            <div>
                <h1 class="font-bold text-sm tracking-widest text-brandAccent uppercase">Maynard's birthday</h1>
                <p class="text-xs text-brandDark/70" id="status-bar">Secure Verification Gateway Loaded</p>
            </div>
        </div>
        <!-- Progress Indicators -->
        <div class="flex items-center gap-4">
            <!-- Floating AI Help Badge -->
            <button onclick="toggleAiDrawer()" class="hidden md:flex items-center gap-2 bg-brandSecondary/40 hover:bg-brandSecondary/80 border border-brandPrimary/60 px-3.5 py-1.5 rounded-full text-xs text-brandAccent font-semibold transition-all">
                <i class="fa-solid fa-wand-magic-sparkles text-brandAccent animate-pulse"></i>
                Ask 30s Oracle
            </button>
            <div class="flex items-center gap-1.5" id="slide-progress-dots">
                <!-- Dynamic Dots Generated by JS -->
            </div>
        </div>
    </header>

    <!-- MAIN INTERACTIVE SLIDE DECK VIEWPORT -->
    <main class="flex-grow flex items-center justify-center p-4 md:p-8 max-w-5xl mx-auto w-full">
        <div class="w-full bg-white/95 border border-brandPrimary/20 rounded-2xl shadow-xl overflow-hidden relative" style="min-height: 550px;">
            
            <!-- PROGRESS BAR IN DECK -->
            <div class="w-full bg-slate-200 h-1.5 relative overflow-hidden">
                <div id="deck-progress" class="bg-brandAccent h-full w-0 transition-all duration-500 ease-out"></div>
            </div>

            <!-- SLIDE 1: SECURITY CHECKPOINT -->
            <div id="slide-1" class="slide-element p-6 md:p-12 flex flex-col justify-between h-full min-h-[500px]">
                <div class="space-y-6">
                    <div class="flex items-center gap-2 text-brandAccent uppercase tracking-widest text-xs font-semibold">
                        <span class="w-2 h-2 rounded-full bg-brandAccent animate-ping"></span>
                        Decryption Gateway
                    </div>
                    <h2 class="text-3xl md:text-5xl font-serif font-bold text-brandDark leading-tight">
                        Verification Required. Are you <span class="text-brandAccent text-underline-accent">Maynard</span>?
                    </h2>
                    <p class="text-slate-600 text-sm md:text-base max-w-xl">
                        This digital transmission is classified. To prevent unauthorized birthday leaks, we must verify you are indeed the legendary Maynard currently conquering your glorious thirties.
                    </p>
                </div>

                <!-- TREASURE HUNT PUZZLE 1 -->
                <div class="my-6 p-5 rounded-xl bg-brandLightBg/60 border border-brandPrimary/40 space-y-4" id="puzzle-box-1">
                    <label class="block text-xs uppercase tracking-wider text-brandAccent font-bold">
                        <i class="fa-solid fa-key mr-2 text-brandAccent"></i>Security Challenge:
                    </label>
                    <p class="text-base text-slate-700 font-semibold">
                        "Who is your best female friend?"
                    </p>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input type="text" id="best-friend-input" placeholder="Enter her name..." 
                               class="bg-white border border-brandPrimary rounded-lg px-4 py-3 text-brandDark focus:outline-none focus:ring-2 focus:ring-brandAccent w-full sm:w-64 text-center font-bold text-lg">
                        <button onclick="verifyBestFriend()" class="bg-brandAccent text-white hover:bg-brandDark px-6 py-3 rounded-lg font-bold tracking-wider text-sm transition-all flex items-center justify-center gap-2 shadow-sm">
                            <i class="fa-solid fa-unlock"></i> Decrypt Card
                        </button>
                    </div>
                    <p class="text-xs text-brandAccent italic">
                        <i class="fa-solid fa-circle-info mr-1"></i> Hint: NOT the French version of her name.
                    </p>
                    <p id="error-feedback-1" class="text-red-500 text-xs font-semibold hidden animate-bounce"></p>
                </div>

                <div class="flex justify-between items-center text-xs text-slate-500">
                    <span>STATUS: LOCKED 🔒</span>
                    <span>SLIDE 1 OF 5</span>
                </div>
            </div>

            <!-- SLIDE 2: VIDEO ACTIVITY (INTERACTIVE TRIVIA GAME) -->
            <div id="slide-2" class="slide-element p-6 md:p-12 flex flex-col justify-between h-full min-h-[500px] hidden">
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-brandAccent uppercase tracking-widest text-xs font-semibold">
                        <i class="fa-solid fa-gamepad"></i> Maynard's Level Unlocker
                    </div>
                    <h2 class="text-2xl md:text-3xl font-serif font-bold text-brandDark">
                        The <span class="text-brandAccent text-underline-accent">"Thriving in Your Thirties"</span> Video Activity Challenge
                    </h2>
                    <p class="text-slate-600 text-xs md:text-sm">
                        To unlock your special broadcast and birthday video stream, answer these highly scientific questions about what it truly means to be thriving in your thirties:
                    </p>
                </div>

                <!-- GAME INTERACTIVE AREA -->
                <div id="game-card" class="my-6 p-6 rounded-xl bg-slate-50 border border-brandPrimary/40 min-h-[250px] flex flex-col justify-between transition-all shadow-sm">
                    <div id="game-question-zone" class="space-y-4">
                        <div class="flex justify-between items-center">
                            <span id="game-step-badge" class="text-xs bg-brandAccent text-white px-3 py-0.5 rounded-full font-bold">Question 1/3</span>
                            <span id="game-points-badge" class="text-xs text-brandAccent font-mono font-bold">Score: 0</span>
                        </div>
                        <h3 id="game-question-text" class="text-base md:text-lg font-bold text-brandDark">Loading trivia...</h3>
                        
                        <div id="game-options-zone" class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
                            <!-- Dynamic Option Buttons -->
                        </div>

                        <!-- FEEDBACK AND CONTROL ZONE -->
                        <div id="trivia-feedback-panel" class="hidden mt-4 p-4 rounded-xl border flex flex-col sm:flex-row items-center justify-between gap-3 transition-all">
                            <div class="flex items-center gap-2">
                                <span id="feedback-icon" class="text-lg"></span>
                                <p id="feedback-msg" class="text-sm font-semibold"></p>
                            </div>
                            <div id="feedback-actions" class="flex gap-2">
                                <!-- Dynamic control buttons appear here -->
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    <button onclick="prevSlide()" class="text-xs text-slate-500 hover:text-brandAccent transition-all"><i class="fa-solid fa-arrow-left mr-1"></i> Prev</button>
                    <span class="text-xs text-slate-500">SLIDE 2 OF 5</span>
                    <button onclick="nextSlide()" id="next-to-3" class="text-xs text-slate-400 hover:text-brandAccent transition-all font-bold pointer-events-none opacity-40">Complete Game to Unlock Cake <i class="fa-solid fa-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- SLIDE 3: IMAGEN AI DREAM CAKE GENERATOR & CANDLE BLOW STATION -->
            <div id="slide-3" class="slide-element p-6 md:p-12 flex flex-col justify-between h-full min-h-[500px] hidden">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-brandAccent uppercase tracking-widest text-xs font-semibold">
                            <i class="fa-solid fa-wand-magic-sparkles text-brandAccent animate-pulse"></i> Dream Cake Laboratory
                        </div>
                        <span class="text-[10px] bg-brandSecondary/80 text-brandAccent px-2 py-0.5 rounded-full font-mono font-bold">imagen-4.0-generate-001</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-serif font-bold text-brandDark">
                        Bake Your Cake & <span class="text-brandAccent text-underline-accent">Blow the Candle!</span>
                    </h2>
                    <p class="text-slate-600 text-xs md:text-sm">
                        Tell Google's AI what your absolute fantasy birthday cake looks like (e.g., retro console cake, custom sports cake). Once baked, your virtual candle will appear on top for you to blow out!
                    </p>
                </div>

                <!-- BAKE STATION UI -->
                <div class="my-4 p-5 rounded-xl bg-brandLightBg/60 border border-brandPrimary/40 space-y-3">
                    <div class="flex flex-col sm:flex-row gap-2" id="cake-input-section">
                        <input type="text" id="ai-cake-prompt" placeholder="e.g. A retro arcade cabinet birthday cake with neon lighting, 8k resolution" 
                               class="bg-white border border-brandPrimary rounded-lg px-3 py-2 text-slate-800 text-xs focus:outline-none focus:ring-2 focus:ring-brandAccent flex-grow">
                        <button onclick="bakeAiCake()" id="btn-bake-cake" class="bg-brandAccent text-white hover:bg-brandDark px-4 py-2 rounded-lg text-xs font-bold transition-all shrink-0 flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-cookie-bite animate-pulse"></i> Bake Cake!
                        </button>
                    </div>

                    <!-- CAKE DISPLAY PORT WITH CANDLE OVERLAY -->
                    <div id="ai-cake-container" class="hidden relative aspect-video w-full max-w-md mx-auto rounded-lg overflow-hidden border border-brandPrimary/40 bg-slate-100 flex items-center justify-center mt-3 shadow-inner">
                        <img id="ai-cake-result" class="w-full h-full object-cover" alt="Generated Birthday Concept" />
                        
                        <!-- Dynamic Candle Overlay Placed Directly On Top Of Baked Cake -->
                        <div id="candle-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-black/40 hidden">
                            <!-- Candle Element -->
                            <div class="relative w-24 h-32 flex flex-col items-center justify-end">
                                <!-- Candle Flame -->
                                <div id="candle-flame" class="w-6 h-8 bg-amber-400 rounded-full blur-[1px] animate-pulse absolute top-4 transition-all duration-500 origin-bottom"></div>
                                <!-- Candle Stick -->
                                <div class="w-2.5 h-14 bg-gradient-to-t from-red-500 to-amber-300 rounded-t-md z-10 shadow"></div>
                            </div>
                        </div>

                        <div id="ai-cake-loader" class="absolute inset-0 bg-white/95 backdrop-blur-sm flex flex-col items-center justify-center gap-2">
                            <i class="fa-solid fa-spinner animate-spin text-brandAccent text-3xl"></i>
                            <span class="text-xs text-brandAccent font-semibold">AI is baking your custom cake...</span>
                        </div>
                    </div>

                    <!-- Clean, Non-Blocking Instruction Card Placed Outside the Cake Aspect Frame -->
                    <div id="cake-instruction-box" class="hidden mt-3 p-4 rounded-xl border-2 border-brandAccent bg-white shadow-lg text-center max-w-xs mx-auto transition-all">
                        <h4 class="font-black text-lg text-brandDark mb-1">Make a wish! 💨</h4>
                        <p class="text-sm font-bold text-brandAccent mb-2 leading-relaxed">
                            YOU MUST BLOW OUT THE VIRTUAL CANDLE TO MAKE YOUR WISH & UNLOCK YOUR VIDEO!
                        </p>
                        <p class="text-xs text-slate-500 mb-3">Click or tap the flame repeatedly to blow it out.</p>
                        <button onclick="blowCandle()" id="blow-button" class="bg-brandAccent hover:bg-brandDark text-white text-xs font-bold uppercase py-2 px-4 rounded-lg transition-all w-full shadow-md">
                            💨 Blow Out Flame
                        </button>
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    <button onclick="prevSlide()" class="text-xs text-slate-500 hover:text-brandAccent transition-all"><i class="fa-solid fa-arrow-left mr-1"></i> Prev</button>
                    <span class="text-xs text-slate-500">SLIDE 3 OF 5</span>
                    <button onclick="nextSlide()" id="next-to-4" class="text-xs text-slate-400 hover:text-brandAccent transition-all font-bold pointer-events-none opacity-40">Blow out Candle to Unlock Video <i class="fa-solid fa-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- SLIDE 4: THE VIDEO BROADCAST -->
            <div id="slide-4" class="slide-element p-6 md:p-12 flex flex-col justify-between h-full min-h-[500px] hidden">
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-brandAccent uppercase tracking-widest text-xs font-semibold">
                        <i class="fa-solid fa-satellite-dish"></i> Live Stream Transmission
                    </div>
                    <h2 class="text-2xl md:text-3xl font-serif font-bold text-brandDark">
                        A Special Message: <span class="text-brandAccent text-underline-accent">Overseas Broadcast</span>
                    </h2>
                    <p class="text-slate-600 text-xs md:text-sm">
                        Physical distance has nothing on solid friendship. To celebrate you, here is a throwback to class, fun, and entertainment. Stream your dedicated birthday tribute:
                    </p>
                </div>

                <!-- VIDEO PLAYER MOCK POSTER (BYPASSES ALL IFRAME BLOCKS AND ERROR 153) -->
                <div class="my-6 aspect-video w-full max-w-2xl mx-auto rounded-xl overflow-hidden border-2 border-brandPrimary bg-slate-950 relative shadow-xl group cursor-pointer" onclick="loadRealBirthdayVideo()" id="video-wrapper">
                    <!-- High-Fidelity Video Poster Interface -->
                    <div class="absolute inset-0 bg-gradient-to-br from-brandDark/90 to-brandAccent/80 flex flex-col items-center justify-center transition-all duration-300 z-10 group-hover:from-brandDark group-hover:to-brandAccent">
                        <!-- Play Button SVG mimicking clean video player -->
                        <div class="w-20 h-20 rounded-full bg-white text-brandAccent flex items-center justify-center shadow-2xl transform scale-100 group-hover:scale-110 active:scale-95 transition-all duration-300">
                            <i class="fa-solid fa-play text-3xl ml-1.5 text-brandAccent"></i>
                        </div>
                        <div class="text-center p-6 space-y-2 mt-4">
                            <h4 class="text-white font-bold text-lg tracking-wider">Play Maynard's Birthday Song & Tribute</h4>
                            <p class="text-xs text-brandSecondary/90 font-medium">Click to stream cleanly in a secure, new browser window</p>
                            <span class="inline-block mt-2 px-3 py-1 bg-white/20 text-white rounded-full text-[10px] uppercase tracking-wider font-bold"><i class="fa-solid fa-bolt mr-1"></i> Bypasses Iframe Sandbox Blocks</span>
                        </div>
                    </div>
                </div>

                <!-- Video Fallback & Custom Link Config Panel -->
                <div class="p-4 rounded-lg bg-brandSecondary/30 border border-brandPrimary/30 flex flex-col gap-3">
                    <div class="flex flex-col sm:flex-row gap-3 items-center justify-between">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-circle-info text-brandAccent text-lg shrink-0"></i>
                            <p class="text-sm text-slate-700" id="mission-brief-text">
                                <strong>Mission Brief:</strong> Click the player above to watch the video and unlock your celebration.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    <button onclick="prevSlide()" class="text-xs text-slate-500 hover:text-brandAccent transition-all"><i class="fa-solid fa-arrow-left mr-1"></i> Prev</button>
                    <span class="text-xs text-slate-500">SLIDE 4 OF 5</span>
                    <button onclick="nextSlide()" id="next-to-5" class="text-xs text-slate-400 hover:text-brandAccent transition-all font-bold pointer-events-none opacity-40">Watch video to unlock persona quotes <i class="fa-solid fa-arrow-right ml-1"></i></button>
                </div>
            </div>

            <!-- SLIDE 5: THE ANIMATED HAPPY BIRTHDAY CARD, TRIBUTE, & THE CHAMPAGNE TOAST -->
            <div id="slide-5" class="slide-element p-6 md:p-12 flex flex-col justify-between h-full min-h-[500px] hidden">
                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-2 text-brandAccent uppercase tracking-widest text-xs font-semibold">
                            <i class="fa-regular fa-envelope-open"></i> Birthday Dossier Unlocked
                        </div>
                        <span class="text-xs text-brandAccent bg-brandSecondary/50 px-3 py-1 rounded-full border border-brandPrimary/30 flex items-center gap-1 font-semibold">
                            <i class="fa-solid fa-sparkles text-brandAccent animate-pulse"></i> Gemini AI Boosted
                        </span>
                    </div>
                    
                    <!-- Framed Quote mimicking "57 Birthday Wishes For Friends – Happy Birthday Quotes.jpg" -->
                    <div class="p-6 md:p-8 rounded-xl bg-gradient-to-br from-brandSecondary/20 to-brandPrimary/10 border border-brandPrimary/40 relative overflow-hidden shadow-inner">
                        <div class="absolute top-0 right-0 p-4 opacity-10">
                            <i class="fa-solid fa-quote-right text-8xl text-brandAccent"></i>
                        </div>
                        <p class="text-xs text-brandAccent font-bold uppercase tracking-widest mb-3">
                            <i class="fa-solid fa-heart mr-1"></i> Quote Tribute from <span class="italic font-normal">"57 Birthday Wishes For Friends – Happy Birthday Quotes.jpg"</span>
                        </p>
                        
                        <blockquote id="birthday-quote-text" class="font-serif text-xl md:text-2xl italic text-brandDark leading-relaxed max-w-2xl transition-all duration-300">
                            "A special friend like you deserves all the wonderful blessings not only today but every day! Happy birthday! May all your wishes come true."
                        </blockquote>

                        <!-- AI Customization Control Bar -->
                        <div class="mt-4 p-3 bg-white/90 rounded-lg border border-brandPrimary/30 flex flex-wrap items-center justify-between gap-3 shadow-sm">
                            <span class="text-xs text-slate-600 font-semibold flex items-center gap-1.5">
                                <i class="fa-solid fa-wand-magic-sparkles text-brandAccent"></i> Adjust Quote Persona:
                            </span>
                            <div class="flex flex-wrap gap-1.5">
                                <button onclick="reStyleQuote('original')" id="btn-persona-original" class="text-xs bg-brandAccent text-white px-2.5 py-1 rounded font-bold transition-all">Original</button>
                                <button onclick="reStyleQuote('roast')" id="btn-persona-roast" class="text-xs bg-slate-100 hover:bg-brandSecondary text-brandAccent px-2.5 py-1 rounded transition-all">Comedic Roast 💀</button>
                                <button onclick="reStyleQuote('sage')" id="btn-persona-sage" class="text-xs bg-slate-100 hover:bg-brandSecondary text-brandAccent px-2.5 py-1 rounded transition-all">Old Wise Sage 🧙‍♂️</button>
                                <button onclick="reStyleQuote('hype')" id="btn-persona-hype" class="text-xs bg-slate-100 hover:bg-brandSecondary text-brandAccent px-2.5 py-1 rounded transition-all">Cyber Hype ⚡</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Symmetrical Champagne Clinking Mechanism -->
                <div class="my-4 p-4 rounded-xl border border-brandPrimary/30 bg-white shadow-sm flex flex-col items-center gap-4">
                    <h4 class="text-sm font-bold text-brandAccent uppercase tracking-widest text-center">🥂 Virtual Birthday Cheers!</h4>
                    <div class="flex gap-16 justify-center items-center h-28 relative px-8">
                        
                        <!-- Left Champagne Flute (Custom elegant SVG) -->
                        <div id="glass-left" class="glass-left-style relative">
                            <svg class="w-14 h-28" viewBox="0 0 50 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Flute glass outline -->
                                <path d="M15 10 C15 45, 35 45, 35 10 L35 5 L15 5 Z" stroke="#2C5E77" stroke-width="2" fill="#CBE1EC" fill-opacity="0.3"/>
                                <!-- Champagne liquid inside -->
                                <path d="M17 15 C17 38, 33 38, 33 15 Z" fill="#F4D068" opacity="0.8"/>
                                <!-- Bubbles rising (custom animated circles) -->
                                <circle class="champagne-bubble" cx="21" cy="30" r="1.5" fill="#FFF" style="animation-delay: 0.2s;"/>
                                <circle class="champagne-bubble" cx="25" cy="22" r="1" fill="#FFF" style="animation-delay: 0.6s;"/>
                                <circle class="champagne-bubble" cx="29" cy="26" r="1.2" fill="#FFF" style="animation-delay: 0s;"/>
                                <!-- Stem -->
                                <line x1="25" y1="41" x2="25" y2="82" stroke="#2C5E77" stroke-width="2"/>
                                <!-- Base -->
                                <ellipse cx="25" cy="82" rx="14" ry="4" stroke="#2C5E77" stroke-width="2" fill="#CBE1EC"/>
                            </svg>
                        </div>
                        
                        <!-- Right Champagne Flute (Custom elegant SVG) -->
                        <div id="glass-right" class="glass-right-style relative">
                            <svg class="w-14 h-28" viewBox="0 0 50 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Flute glass outline -->
                                <path d="M15 10 C15 45, 35 45, 35 10 L35 5 L15 5 Z" stroke="#2C5E77" stroke-width="2" fill="#CBE1EC" fill-opacity="0.3"/>
                                <!-- Champagne liquid inside -->
                                <path d="M17 15 C17 38, 33 38, 33 15 Z" fill="#F4D068" opacity="0.8"/>
