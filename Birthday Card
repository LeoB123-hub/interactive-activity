            document.getElementById('game-points-badge').innerText = `Score: ${score}/${triviaData.length}`;
            document.getElementById('game-question-text').innerText = qData.q;
            
            // Hide feedback panel
            const fbPanel = document.getElementById('trivia-feedback-panel');
            fbPanel.classList.add('hidden');

            const optionsZone = document.getElementById('game-options-zone');
            optionsZone.innerHTML = '';

            disabledOptions = [];
            firstTryOnQuestion = true;

            renderOptions();
        }

        function renderOptions() {
            const qData = triviaData[currentQuestionIdx];
            const optionsZone = document.getElementById('game-options-zone');
            optionsZone.innerHTML = '';

            qData.o.forEach((opt, idx) => {
                const isGuessedWrong = disabledOptions.includes(idx);
                const button = document.createElement('button');
                
                // Base styling
                let btnStyles = "w-full text-left p-4 rounded-xl border text-sm transition-all focus:outline-none flex items-start gap-3 shadow-sm ";
                
                if (isGuessedWrong) {
                    btnStyles += "bg-red-50 border-red-300 text-red-500 opacity-60 pointer-events-none cursor-not-allowed";
                } else {
                    btnStyles += "border-brandPrimary/40 bg-white hover:bg-brandSecondary/20 hover:border-brandAccent";
                }

                button.className = btnStyles;
                button.innerHTML = `
                    <span class="w-6 h-6 rounded-full bg-slate-100 border border-brandPrimary/40 flex items-center justify-center text-xs font-bold text-brandAccent shrink-0">${String.fromCharCode(65 + idx)}</span>
                    <span class="text-slate-700">${opt}</span>
                `;
                
                if (!isGuessedWrong) {
                    button.onclick = () => submitAnswer(idx);
                }
                optionsZone.appendChild(button);
            });
        }

        function submitAnswer(selectedIdx) {
            const qData = triviaData[currentQuestionIdx];
            const optionsZone = document.getElementById('game-options-zone');
            const fbPanel = document.getElementById('trivia-feedback-panel');
            const fbIcon = document.getElementById('feedback-icon');
            const fbMsg = document.getElementById('feedback-msg');
            const fbActions = document.getElementById('feedback-actions');

            // Lock all option buttons temporarily
            Array.from(optionsZone.children).forEach(btn => btn.onclick = null);

            if (selectedIdx === qData.correct) {
                // Correct path
                if (firstTryOnQuestion) {
                    score++;
                }

                confetti({
                    particleCount: 40,
                    spread: 45,
                    origin: { y: 0.8 }
                });

                // Style correct option green
                optionsZone.children[selectedIdx].className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-800 text-sm transition-all flex items-start gap-3 shadow-inner pointer-events-none";

                fbPanel.className = "mt-4 p-4 rounded-xl border border-emerald-300 bg-emerald-50 text-emerald-800 flex flex-col sm:flex-row items-center justify-between gap-3 transition-all";
                fbIcon.innerHTML = `<i class="fa-solid fa-circle-check text-xl text-emerald-600 animate-bounce"></i>`;
                fbMsg.innerText = "Spot on! That is exactly correct. 🎉";
                
                const isLast = (currentQuestionIdx === triviaData.length - 1);
                fbActions.innerHTML = `
                    <button onclick="advanceTrivia()" class="px-5 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 text-xs font-bold transition-all shadow-md flex items-center gap-1">
                        ${isLast ? 'Complete Verification' : 'Next Question'} <i class="fa-solid fa-chevron-right"></i>
                    </button>
                `;
                fbPanel.classList.remove('hidden');

            } else {
                // Wrong path
                firstTryOnQuestion = false;
                disabledOptions.push(selectedIdx);

                // Style selected option red
                optionsZone.children[selectedIdx].className = "w-full text-left p-4 rounded-xl border-2 border-red-500 bg-red-50 text-red-800 text-sm transition-all flex items-start gap-3 shadow-inner pointer-events-none";

                fbPanel.className = "mt-4 p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-800 flex flex-col sm:flex-row items-center justify-between gap-3 transition-all";
                fbIcon.innerHTML = `<i class="fa-solid fa-circle-xmark text-xl text-rose-600"></i>`;
                fbMsg.innerText = "Ah, that is not correct. Try again, or reveal the answer!";

                fbActions.innerHTML = `
                    <button onclick="tryAgainTrivia()" class="px-4 py-2 rounded-lg bg-rose-600 text-white hover:bg-rose-700 text-xs font-bold transition-all shadow-md flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left"></i> Try Again
                    </button>
                    <button onclick="revealTriviaCorrectAnswer()" class="px-4 py-2 rounded-lg bg-brandAccent text-white hover:bg-brandDark text-xs font-bold transition-all shadow-md">
                        💡 Show Answer
                    </button>
                `;
                fbPanel.classList.remove('hidden');
            }
        }

        function tryAgainTrivia() {
            const fbPanel = document.getElementById('trivia-feedback-panel');
            fbPanel.classList.add('hidden');
            renderOptions();
        }

        function revealTriviaCorrectAnswer() {
            const qData = triviaData[currentQuestionIdx];
            const optionsZone = document.getElementById('game-options-zone');
            const fbPanel = document.getElementById('trivia-feedback-panel');
            const fbIcon = document.getElementById('feedback-icon');
            const fbMsg = document.getElementById('feedback-msg');
            const fbActions = document.getElementById('feedback-actions');

            // Highlight the correct option in green and dim others
            Array.from(optionsZone.children).forEach((btn, idx) => {
                btn.onclick = null;
                if (idx === qData.correct) {
                    btn.className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-800 text-sm transition-all flex items-start gap-3 shadow-inner pointer-events-none";
                } else {
                    btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 bg-slate-50 text-slate-400 text-sm transition-all flex items-start gap-3 opacity-50 pointer-events-none";
                }
            });

            fbPanel.className = "mt-4 p-4 rounded-xl border border-brandPrimary/40 bg-slate-50 text-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 transition-all";
            fbIcon.innerHTML = `<i class="fa-solid fa-circle-info text-xl text-brandAccent"></i>`;
            fbMsg.innerText = `The correct answer is: Option ${String.fromCharCode(65 + qData.correct)}`;

            const isLast = (currentQuestionIdx === triviaData.length - 1);
            fbActions.innerHTML = `
                <button onclick="advanceTrivia()" class="px-5 py-2 rounded-lg bg-brandAccent text-white hover:bg-brandDark text-xs font-bold transition-all shadow-md flex items-center gap-1">
                    ${isLast ? 'Complete Verification' : 'Next Question'} <i class="fa-solid fa-chevron-right"></i>
                </button>
            `;
            fbPanel.classList.remove('hidden');
        }

        function advanceTrivia() {
            currentQuestionIdx++;
            if (currentQuestionIdx < triviaData.length) {
                loadTriviaQuestion();
            } else {
                state.triviaFinished = true;
                state.triviaScore = score;
                if (state.maxUnlockedSlide < 3) {
                    state.maxUnlockedSlide = 3;
                }
                saveState();
                renderTriviaResult();
                
                const nextBtn = document.getElementById('next-to-3');
                nextBtn.classList.remove('pointer-events-none', 'opacity-40');
                nextBtn.classList.add('text-brandAccent');
            }
        }

        function renderTriviaResult() {
            const zone = document.getElementById('game-card');
            zone.innerHTML = `
                <div class="text-center py-6 space-y-4">
                    <div class="w-16 h-16 rounded-full bg-brandSecondary/60 flex items-center justify-center mx-auto border border-brandPrimary/40">
                        <i class="fa-solid fa-graduation-cap text-3xl text-brandAccent animate-bounce"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-slate-800">Verification Challenge Cleared!</h3>
                        <p class="text-xs text-brandAccent font-bold mt-1">Status: Fully Verified Thirties Legend</p>
                    </div>
                    <div class="inline-block px-4 py-2 bg-brandSecondary/20 rounded-lg border border-brandPrimary/30 text-sm font-semibold text-brandAccent">
                        Verification Final Score: ${state.triviaScore || score} / 3 Correct On First Try
                    </div>
                    <p class="text-xs text-slate-500 max-w-md mx-auto">
                        Your verification score is complete. Navigate to Slide 3 to bake your ultimate birthday dream cake and blow out your candle!
                    </p>
                    <button onclick="showSlide(3)" class="mt-4 bg-brandAccent hover:bg-brandDark text-white font-bold py-2 px-6 rounded-lg text-sm transition-all shadow-md">
                        Proceed to Dream Cake Generator <i class="fa-solid fa-chevron-right ml-1"></i>
                    </button>
                </div>
            `;
        }

        let blowCount = 0;
        function blowCandle() {
            blowCount++;
            const flame = document.getElementById('candle-flame');
            
            if (blowCount < 4) {
                flame.style.transform = `scale(${1 - (blowCount * 0.25)}) skewX(${blowCount * 12}deg)`;
            } else {
                flame.classList.add('opacity-0', 'scale-0');
                state.candleExtinguished = true;
                
                if (state.maxUnlockedSlide < 4) {
                    state.maxUnlockedSlide = 4;
                }
                saveState();
                
                confetti({
                    particleCount: 150,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 }
                });
                confetti({
                    particleCount: 150,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 }
                });

                const btn = document.getElementById('blow-button');
                btn.innerText = "✨ Wish Sent! Slide Unlocked.";
                btn.disabled = true;
                btn.className = "bg-emerald-50 text-emerald-600 border border-emerald-300 py-1.5 px-3 rounded-lg text-[10px] font-bold transition-all w-full shadow-sm";
                
                const nextBtn = document.getElementById('next-to-4');
                if (nextBtn) {
                    nextBtn.classList.remove('pointer-events-none', 'opacity-40');
                    nextBtn.classList.add('text-brandAccent');
                }
                
                showCustomAlert("You blew out the candle! The birthday video stream is now unlocked on the next slide.", "Wish Transmitted!", "fa-wand-magic-sparkles");
            }
        }

        // AI Cake Generator & Candle Assembly (Slide 3)
        async function bakeAiCake() {
            const promptInput = document.getElementById('ai-cake-prompt');
            const promptValue = promptInput.value.trim();
            if (!promptValue) return;

            const container = document.getElementById('ai-cake-container');
            const resultImg = document.getElementById('ai-cake-result');
            const loader = document.getElementById('ai-cake-loader');
            const bakeBtn = document.getElementById('btn-bake-cake');
            const candleOverlay = document.getElementById('candle-overlay');
            const instructionBox = document.getElementById('cake-instruction-box');

            container.classList.remove('hidden');
            loader.classList.remove('hidden');
            candleOverlay.classList.add('hidden');
            if (instructionBox) instructionBox.classList.add('hidden');
            bakeBtn.disabled = true;
            bakeBtn.classList.add('opacity-50', 'pointer-events-none');

            try {
                const finalPrompt = `A premium close-up digital photograph of a marvelous, highly creative birthday cake styled for Maynard. Subject: ${promptValue}. Highly detailed, delicious icing textures, festive lighting.`;
                const imageUrl = await callImagenAPI(finalPrompt);
                
                resultImg.src = imageUrl;
                loader.classList.add('hidden');
                
                // Show Candle overlay directly on top of baked cake and show instruction box below it
                candleOverlay.classList.remove('hidden');
                if (instructionBox) {
                    instructionBox.classList.remove('hidden');
                    // Ensure the instruction box text is larger
                    instructionBox.classList.add('text-lg');
                }
                
                state.cakeBaked = true;
                saveState();
                
                confetti({
                    particleCount: 50,
                    spread: 45,
                    origin: { y: 0.8 }
                });
                
            } catch (err) {
                console.error("Failed to generate birthday cake artwork", err);
                container.classList.add('hidden');
                showCustomAlert("The AI bakery is currently handling high volume! Please try again in a moment.", "Bakery Busy", "fa-cookie-bite");
            } finally {
                bakeBtn.disabled = false;
                bakeBtn.classList.remove('opacity-50', 'pointer-events-none');
            }
        }

        // Custom champagne cheers trigger
        function clinkGlasses() {
            const left = document.getElementById('glass-left');
            const right = document.getElementById('glass-right');
            
            // Add symmetric translation and rotation classes on click (meet perfectly without crossing)
            left.classList.add('clink-left');
            right.classList.add('clink-right');
            
            setTimeout(() => {
                confetti({
                    particleCount: 80,
                    spread: 60,
                    origin: { y: 0.60, x: 0.50 },
                    colors: ['#2C5E77', '#7CB4CF', '#F4D068']
                });

                // Display the gorgeous dedicated card message
                const msgEl = document.getElementById('clink-love-message');
                if (msgEl) {
                    msgEl.classList.remove('hidden');
                }
            }, 150);

            // Return to starting position with transition delay
            setTimeout(() => {
                left.classList.remove('clink-left');
                right.classList.remove('clink-right');
            }, 400);
        }

        async function reStyleQuote(persona) {
            state.activeQuoteStyle = persona;
            saveState();

            ['original', 'roast', 'sage', 'hype'].forEach(p => {
                const button = document.getElementById(`btn-persona-${p}`);
                if (button) {
                    if (p === persona) {
                        button.className = "text-xs bg-brandAccent text-white px-2.5 py-1 rounded font-bold transition-all shadow-sm";
                    } else {
                        button.className = "text-xs bg-slate-100 hover:bg-brandSecondary text-brandAccent px-2.5 py-1 rounded transition-all";
                    }
                }
            });

            const quoteBox = document.getElementById('birthday-quote-text');
            const quoteSign = document.getElementById('quote-signature');

            if (persona === 'original') {
                quoteBox.innerText = originalQuote;
                if (quoteSign) quoteSign.innerText = "";
                return;
            }

            quoteBox.innerHTML = `<span class="flex items-center gap-2 text-brandAccent font-semibold"><i class="fa-solid fa-spinner animate-spin"></i> Gemini is tailoring quote style...</span>`;
            if (quoteSign) quoteSign.innerText = "— Generating AI persona text...";

            let query = "";
            let signature = "";
            
            if (persona === 'roast') {
                query = `The quote from "57 Birthday Wishes For Friends – Happy Birthday Quotes.jpg" is: "${originalQuote}". Rewrite this quote into a friendly but hilarious comedic roast for Maynard on his birthday. Remind him he is in his thirties, cracking joints, aging, being an expat, and finding gray hairs. Keep it emotional but funny, under 45 words.`;
            } else if (persona === 'sage') {
                query = `The quote from "57 Birthday Wishes For Friends – Happy Birthday Quotes.jpg" is: "${originalQuote}". Rewrite this quote into the profound wisdom of an ancient sage welcoming Maynard to his thriving thirties. Mention time, adult wisdom, organic tea, and feeling relaxed. Keep it under 45 words.`;
            } else if (persona === 'hype') {
                query = `The quote from "57 Birthday Wishes For Friends – Happy Birthday Quotes.jpg" is: "${originalQuote}". Rewrite this quote in an incredibly high-energy, futuristic cyberpunk hacker style dedicated to Maynard's thirties core. Keep it under 45 words.`;
            }

            const aiResponse = await callGeminiTextAPI(query, "You write custom birthday toasts for a friend named Maynard who is in his thirties. Keep under 45 words. Maintain high aesthetic values.");
            quoteBox.innerText = `"${aiResponse.replace(/["']/g, "")}"`;
            if (quoteSign) quoteSign.innerText = signature;

            state.lastQuoteText = aiResponse;
            saveState();
        }

        // AI Chat drawer routines
        function toggleAiDrawer() {
            const drawer = document.getElementById('ai-drawer');
            drawer.classList.toggle('translate-x-full');
        }

        async function sendQuickAiQuery(predefinedText) {
            appendChatMessage('user', predefinedText);
            const response = await getOracleAdvice(predefinedText);
            appendChatMessage('oracle', response);
        }

        async function sendCustomAiQuery() {
            const input = document.getElementById('ai-chat-input');
            const query = input.value.trim();
            if (!query) return;
            
            input.value = '';
            appendChatMessage('user', query);
            const response = await getOracleAdvice(query);
            appendChatMessage('oracle', response);
        }

        function appendChatMessage(sender, text) {
            const history = document.getElementById('ai-chat-history');
            const messageDiv = document.createElement('div');
            if (sender === 'user') {
                messageDiv.className = "bg-brandSecondary/40 border border-brandPrimary/30 p-3 rounded-xl text-xs space-y-1 text-right ml-8 shadow-sm";
                messageDiv.innerHTML = `
                    <p class="text-brandAccent font-bold">You:</p>
                    <p class="text-slate-700 leading-relaxed text-left">${text}</p>
                `;
            } else {
                messageDiv.className = "bg-slate-50 border border-brandPrimary/20 p-3 rounded-xl text-xs space-y-1 mr-8 shadow-sm";
                messageDiv.innerHTML = `
                    <p class="text-brandAccent font-bold flex items-center gap-1">
                        <i class="fa-solid fa-wand-magic-sparkles text-brandAccent animate-pulse"></i> Oracle:
                    </p>
                    <p class="text-slate-700 leading-relaxed">${text}</p>
                `;
            }
            history.appendChild(messageDiv);
            history.scrollTop = history.scrollHeight;
        }

        async function getOracleAdvice(userQuery) {
            const systemPrompt = "You are the witty, humorous 'Thirties Oracle' chatbot built directly into a light-themed digital birthday card for Maynard. Maynard is currently living overseas. Keep your tone highly friendly, sarcastic, warm, and highly engaging. Discuss funny realities of being in your thirties: back aches, loving cheese boards, sleeping early, vintage arcade games, and complaining about the weather. Keep your response under 3 sentences.";
            return await callGeminiTextAPI(userQuery, systemPrompt);
        }

        function loadSavedState() {
            const saved = localStorage.getItem('maynard_birthday_state');
            if (saved) {
                try {
                    state = JSON.parse(saved);
                    
                    // Clean up legacy URLs if they contain old values
                    if (state.customVideoUrl && (state.customVideoUrl.includes("oceans") || state.customVideoUrl.includes("zencdn"))) {
                        state.customVideoUrl = '';
                    }
                    
                    currentSlide = state.maxUnlockedSlide;
                    updateUIForState();
                    showSlide(currentSlide);

                    if (state.customVideoUrl) {
                        const inputField = document.getElementById('custom-video-url-input');
                        if (inputField) {
                            inputField.value = state.customVideoUrl;
                        }
                    }

                    if (state.activeQuoteStyle && state.activeQuoteStyle !== 'original' && state.lastQuoteText) {
                        setTimeout(() => {
                            reStyleQuote(state.activeQuoteStyle);
                        }, 500);
                    }
                } catch (e) {
                    console.error("Error reloading progress", e);
                }
            } else {
                showSlide(1);
            }
            updateDots();
        }

        function saveState() {
            localStorage.setItem('maynard_birthday_state', JSON.stringify(state));
        }

        function updateUIForState() {
            if (state.puzzle1Solved) {
                document.getElementById('puzzle-box-1').innerHTML = `
                    <div class="text-center py-4 text-emerald-600 font-semibold flex flex-col items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-4xl text-brandAccent animate-pulse"></i>
                        <span>Protocol Activated! Welcome back, Maynard.</span>
                    </div>
                `;
            }
            if (state.triviaFinished) {
                const nextBtn = document.getElementById('next-to-3');
                if(nextBtn) {
                    nextBtn.classList.remove('pointer-events-none', 'opacity-40');
                    nextBtn.classList.add('text-brandAccent');
                }
                renderTriviaResult();
            }
            if (state.cakeBaked) {
                const container = document.getElementById('ai-cake-container');
                const resultImg = document.getElementById('ai-cake-result');
                const loader = document.getElementById('ai-cake-loader');
                const candleOverlay = document.getElementById('candle-overlay');
                const instructionBox = document.getElementById('cake-instruction-box');
                
                if (container) container.classList.remove('hidden');
                if (loader) loader.classList.add('hidden');
                if (resultImg && !resultImg.src) {
                    resultImg.src = generateLocalMockImage("reloaded cake");
                }
                if (candleOverlay && !state.candleExtinguished) {
                    candleOverlay.classList.remove('hidden');
                    if (instructionBox) {
                        instructionBox.classList.remove('hidden');
                        instructionBox.classList.add('text-lg');
                    }
                }
            }
            if (state.candleExtinguished) {
                const flame = document.getElementById('candle-flame');
                if(flame) flame.classList.add('opacity-0', 'scale-0');
                const btn = document.getElementById('blow-button');
                if(btn) {
                    btn.innerText = "✨ Wish Sent! Slide Unlocked.";
                    btn.disabled = true;
                    btn.className = "bg-emerald-50 text-emerald-600 border border-emerald-300 py-1.5 px-3 rounded-lg text-[10px] font-bold transition-all w-full shadow-sm";
                }
                const nextBtn = document.getElementById('next-to-4');
                if(nextBtn) {
                    nextBtn.classList.remove('pointer-events-none', 'opacity-40');
                    nextBtn.classList.add('text-brandAccent');
                }
            }
            if (state.videoViewed) {
                const nextBtn = document.getElementById('next-to-5');
                if(nextBtn) {
                    nextBtn.classList.remove('pointer-events-none', 'opacity-40');
                    nextBtn.classList.add('text-brandAccent');
                }
                const briefText = document.getElementById('mission-brief-text');
                if (briefText) {
                    briefText.innerHTML = `<strong>Mission Brief:</strong> Video launched in a new window! <span class="text-emerald-600 font-semibold ml-1"><i class="fa-solid fa-circle-check"></i> Unlocked!</span>`;
                }
            }
        }

        window.onload = function() {
            loadSavedState();
            loadTriviaQuestion();
        }
    </script>
</body>
</html>
