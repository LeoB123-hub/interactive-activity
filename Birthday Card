                return "Happy Birthday, Maynard! You have officially cruised into the peak of your thirties, where sleeping by 9:30 PM counts as an adrenaline-fueled wild night out, and joint noises are basically your body applauding your daily survival!";
            } else if (lower.includes('sage')) {
                return "Within your thirties, the noise of the world settles, Maynard. Savor the peacefulness of your evening teas and precise posture alignments. May the tranquility of your thirties blossom beautifully.";
            } else if (lower.includes('hype')) {
                return "CORE CRITICAL OVERLAY STATUS ACTIVE! Maynard Thirties Core has achieved full system security levels. Prepare for ultimate celebratory feedback cycles! Stay legendary, absolute champion!";
            } else if (lower.includes('pop') || lower.includes('back')) {
                return "That spine pop is simply your internal chassis confirming it has logged another magnificent decade. Keep your head high, Maynard!";
            } else if (lower.includes('sleep') || lower.includes('excuse')) {
                return "Inform them that you have a high-priority international briefing scheduled with your comfortable ergonomic mattress at exactly 8:45 PM.";
            } else if (lower.includes('quote') || lower.includes('motivation')) {
                return "Your thirties are the spectacular golden era of life: you are young enough to make big plays, but wise enough to decline messy morning hangovers. Keep winning!";
            }
            return "The Thirties Oracle has finalized telemetry calibrations. Enjoy your incredible thirties, Maynard!";
        }

        async function callImagenAPI(imagePrompt) {
            const apiKey = ""; // Platform key injected at runtime
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/imagen-4.0-generate-001:predict?key=${apiKey}`;
            
            const payload = {
                instances: { prompt: imagePrompt },
                parameters: { "sampleCount": 1 }
            };

            try {
                const response = await fetchWithRetry(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const result = await response.json();
                const base64Bytes = result.predictions?.[0]?.bytesBase64Encoded;
                if (!base64Bytes) throw new Error("Missing predictions in response");
                return `data:image/png;base64,${base64Bytes}`;
            } catch (err) {
                console.warn("Imagen API failed, trying secondary model fallback...", err);
                try {
                    return await callFlashImageAPI(imagePrompt, apiKey);
                } catch (fallbackErr) {
                    console.warn("Flash image fallback failed, returning custom vector SVG art...", fallbackErr);
                    return generateLocalMockImage(imagePrompt);
                }
            }
        }

        async function callFlashImageAPI(imagePrompt, apiKey) {
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-image-preview:generateContent?key=${apiKey}`;
            const payload = {
                contents: [{
                    parts: [{ text: imagePrompt }]
                }],
                generationConfig: {
                    responseModalities: ['IMAGE']
                }
            };
            const response = await fetchWithRetry(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error("Failed to post flash image query");
            const result = await response.json();
            const base64Data = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData)?.inlineData?.data;
            if (!base64Data) throw new Error("No inlineData in flash response");
            return `data:image/png;base64,${base64Data}`;
        }

